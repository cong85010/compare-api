{
  "manifest_version": 3,
  "name": "API Compare OLD - NEW",
  "version": "1.0",
  "description": "Automatically capture and compare two API responses.",
  "permissions": [
    "webRequest",
    "declarativeNetRequest",
    "activeTab",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
